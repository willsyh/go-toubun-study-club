# Copy to .env.local and fill in.

# Required in production: at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Neon Postgres connection string (Neon dashboard > Connect). Required in production.
# Without it, development stores accounts in data/users.json.
DATABASE_URL=

# Public URL of the site (used for Google redirect and reset links). Optional in dev.
# APP_URL=http://localhost:3000

# Optional: Google sign-in. Create an OAuth client at console.cloud.google.com
# and add <APP_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
